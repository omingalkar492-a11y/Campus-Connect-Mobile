rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function getUserCollegeId() {
      return getUserData().collegeId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }

    // Strict College Admin check (Super Admin does NOT inherit college-level operational authority)
    function isCollegeAdminOnly(collegeId) {
      return isAuthenticated() && getUserRole() == 'college_admin' && getUserCollegeId() == collegeId;
    }

    function isCollegeAdmin(collegeId) {
      return isCollegeAdminOnly(collegeId);
    }

    function isFoodCourtStaff(collegeId) {
      return isAuthenticated() && getUserRole() == 'food_court_staff' && getUserCollegeId() == collegeId;
    }

    function isTeacherStaff(collegeId) {
      return isCollegeAdminOnly(collegeId) || (isAuthenticated() && getUserRole() == 'teacher_staff' && getUserCollegeId() == collegeId);
    }

    function isStudent(collegeId) {
      return isAuthenticated() && getUserRole() == 'student' && getUserCollegeId() == collegeId;
    }

    function belongsToCollege(collegeId) {
      return isSuperAdmin() || (isAuthenticated() && getUserCollegeId() == collegeId);
    }

    // 1. Colleges directory
    match /colleges/{collegeId} {
      allow read: if true; // Public for discovery and onboarding
      allow write: if isSuperAdmin();
    }

    // 2. User profiles with strict institutional boundaries
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isCollegeAdminOnly(resource.data.collegeId) ||
        isSuperAdmin()
      );

      // Super Admin ONLY creates college admins; College Admin ONLY creates teacher & food court staff
      allow create: if isAuthenticated() && (
        (request.resource.data.role == 'college_admin' && isSuperAdmin()) ||
        ((request.resource.data.role == 'teacher_staff' || request.resource.data.role == 'food_court_staff') && isCollegeAdminOnly(request.resource.data.collegeId)) ||
        (request.resource.data.role == 'student' && request.auth.uid == userId)
      );

      allow update: if isAuthenticated() && (
        (request.resource.data.role == 'college_admin' && isSuperAdmin()) ||
        ((request.resource.data.role == 'teacher_staff' || request.resource.data.role == 'food_court_staff') && isCollegeAdminOnly(request.resource.data.collegeId)) ||
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );

      // Super Admin can delete college admins; College Admin can delete staff
      allow delete: if isAuthenticated() && (
        (resource.data.role == 'college_admin' && isSuperAdmin()) ||
        ((resource.data.role == 'teacher_staff' || resource.data.role == 'food_court_staff') && isCollegeAdminOnly(resource.data.collegeId))
      );
    }

    // 3. Buildings, Rooms & Departments (Exclusively governed by College Admin)
    match /departments/{deptId} {
      allow read: if belongsToCollege(resource.data.collegeId);
      allow write: if isCollegeAdminOnly(request.resource.data.collegeId);
    }

    match /rooms/{roomId} {
      allow read: if belongsToCollege(resource.data.collegeId);
      allow write: if isCollegeAdminOnly(request.resource.data.collegeId);
    }

    // 4. Faculty
    match /faculty/{facultyId} {
      allow read: if belongsToCollege(resource.data.collegeId);
      allow write: if isCollegeAdminOnly(request.resource.data.collegeId);
    }

    // 5. Timetable
    match /timetable/{slotId} {
      allow read: if belongsToCollege(resource.data.collegeId);
      allow write: if isCollegeAdminOnly(request.resource.data.collegeId) || isTeacherStaff(request.resource.data.collegeId);
    }

    // 6. 360° Campus Locations (Exclusively governed by College Admin; Super Admin CANNOT modify)
    match /campus360Locations/{locationId} {
      allow read: if belongsToCollege(resource.data.collegeId);
      allow write: if isCollegeAdminOnly(request.resource.data.collegeId);
    }

    // 7. Food Courts & Food Items (Partitioned: College Admin cannot inspect food products or live inventory)
    match /foodCourts/{courtId} {
      allow read: if belongsToCollege(resource.data.collegeId);
      allow write: if isCollegeAdminOnly(request.resource.data.collegeId);
    }

    match /foodItems/{itemId} {
      allow read: if isFoodCourtStaff(resource.data.collegeId) || isStudent(resource.data.collegeId);
      // Only Food Court Staff manage their products & live availability
      allow write: if isFoodCourtStaff(request.resource.data.collegeId);
    }

    // 8. Orders (Partitioned: College Admin has NO access to live orders or order counts)
    match /orders/{orderId} {
      // Student can read their own orders; Food court staff can read orders for their college
      allow read: if isAuthenticated() && (
        resource.data.studentUid == request.auth.uid ||
        isFoodCourtStaff(resource.data.collegeId)
      );
      // Students create orders; items are price-locked
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid;
      // Only Food Court Staff update or complete orders
      allow update: if isFoodCourtStaff(resource.data.collegeId);
      allow delete: if isFoodCourtStaff(resource.data.collegeId);
    }

    // 9. Pickup OTPs (PROTECTED: never readable by food court staff directly)
    match /pickupOtps/{orderId} {
      allow read: if isAuthenticated() && resource.data.studentUid == request.auth.uid;
      allow write: if false; // Server-side Cloud Functions only
    }

    // 10. Notices & Announcements
    match /notices/{noticeId} {
      allow read: if belongsToCollege(resource.data.collegeId);
      allow write: if isCollegeAdmin(request.resource.data.collegeId) || isTeacherStaff(request.resource.data.collegeId);
    }

    // 11. Audit Logs
    match /auditLogs/{logId} {
      allow read: if isCollegeAdmin(resource.data.collegeId) || isSuperAdmin();
      allow write: if false; // Cloud Functions only
    }

    // 12. Food Court Bank & Payout Configuration
    match /payoutConfigs/{configId} {
      // Students read active VPA during checkout; Only staff/admin can update bank details
      allow read: if isAuthenticated();
      allow write: if isFoodCourtStaff(request.resource.data.collegeId) || isCollegeAdmin(request.resource.data.collegeId);
    }
  }
}
